# ── Site ────────────────────────────────────────────────────────────────────
# Public URL without a trailing slash. Used for canonical URLs, hreflang, sitemaps, OG images.
SITE_URL=https://csvtovcf.com

# ── Analytics (build time) ──────────────────────────────────────────────────
# none | plausible. Plausible is cookieless; only page views and one anonymous
# "Conversion" event (vCard version, output, source type, contact-count range) are sent.
ANALYTICS_PROVIDER=none
# Domain as registered in Plausible.
PLAUSIBLE_DOMAIN=csvtovcf.com
# Script URL. For self-hosted Plausible use https://your-plausible.example/js/script.js
PLAUSIBLE_SRC=https://plausible.io/js/script.js
# Runtime header: when analytics are on, add its origin, e.g.  'self' https://plausible.io
CSP_CONNECT='self'

# ── Ads (build time) ────────────────────────────────────────────────────────
# Off by default. When true, fixed-size ad slots appear outside the converter and the CSP
# allows Google ad hosts. In the EEA/UK/CH a Google-certified CMP must be configured in AdSense.
ADS_ENABLED=false
# AdSense publisher id, e.g. ca-pub-1234567890123456
ADSENSE_CLIENT=

# ── Search engines (build time) ─────────────────────────────────────────────
# Google Search Console HTML-tag verification token (content of the meta tag only).
GSC_VERIFICATION=
# Bing Webmaster Tools verification token (msvalidate.01).
BING_VERIFICATION=
# IndexNow key (8–128 chars: a-z A-Z 0-9 -). Published as /<key>.txt; used by scripts/indexnow.mjs.
INDEXNOW_KEY=

# ── Deployment ──────────────────────────────────────────────────────────────
# Host port for the web container.
PORT=8080
# Image name and tag pulled/built by docker compose.
IMAGE=ghcr.io/itensity-dev/csvtovcf
TAG=latest
# 1 = compress the Caddy binary with UPX (keeps the image under 60 MB). 0 = skip.
UPX=1
# VPS profile (edge HTTPS): your domain and the e-mail for Let's Encrypt.
DOMAIN=csvtovcf.com
ACME_EMAIL=
