---
import data from '../../generated/licenses.json';
import type { Lang } from '../../i18n/config';
import { dict } from '../../i18n';

interface Props {
  lang: Lang;
}
const d = dict(Astro.props.lang).licenses;
const groups = [
  ['browser', d.browser],
  ['fonts', d.fonts],
  ['build', d.build],
] as const;
---
{
  groups.map(([k, title]) => (
    <section class="lic">
      <h2>{title}</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th scope="col">{d.name}</th>
              <th scope="col">{d.version}</th>
              <th scope="col">{d.license}</th>
            </tr>
          </thead>
          <tbody>
            {data[k].map((p) => (
              <tr>
                <th scope="row">
                  <a href={p.url} rel="noopener">{p.name}</a>
                </th>
                <td class="mono num">{p.version}</td>
                <td class="mono">{p.license}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))
}
<style>
  .lic {
    margin-block-start: var(--s-6);
  }
  .lic h2 {
    margin-block-end: var(--s-3);
    font-size: var(--fs-3);
  }
</style>
