---
import Base from '../layouts/Base.astro';
import '../styles/tool.css';
import { Card } from '../tool/Card';
import { dict } from '../i18n';
import { emptyContact } from 'csvtovcf';

const d = dict('en');
const s = { tool: d.tool, fields: d.fields, fieldGroups: d.fieldGroups };
const colors = [
  ['--paper', 'Manila folder — page and work area background'],
  ['--paper-2', 'Darker manila — footer, file tabs'],
  ['--card', 'Card stock — cards, inputs, panels'],
  ['--card-2', 'Card stock, hover / secondary'],
  ['--ink', 'Black ink — text, frames, wires'],
  ['--ink-2', 'Secondary text (≥ 7:1 on card)'],
  ['--ink-3', 'Labels, captions (≥ 4.5:1 on card)'],
  ['--hairline', 'Hairlines, separators (decorative)'],
  ['--rule', 'Red headline rule; also errors'],
  ['--line-blue', 'Blue ruled lines (decorative only)'],
  ['--action', 'The one accent: buttons, links, focus'],
  ['--action-soft', 'Action tint: drag-over, hover'],
];
const sizes = ['--fs-0', '--fs-1', '--fs-2', '--fs-3', '--fs-4', '--fs-5', '--fs-6'];
const space = ['--s-1', '--s-2', '--s-3', '--s-4', '--s-5', '--s-6', '--s-7', '--s-8'];
const sample = {
  ...emptyContact(0, 2),
  given: 'Ann',
  family: 'Lee',
  fullName: 'Ann Lee',
  org: 'Lee & Co',
  title: 'Founder',
  phones: [
    { value: '+12025550143', raw: '', type: 'cell' as const, valid: true },
    { value: '4.4E+11', raw: '4.4E+11', type: 'cell' as const, valid: false, issue: 'excel-scientific' as const },
  ],
  emails: [{ value: 'ann.lee@example.com', type: 'work' as const }],
  birthday: { year: 1990, month: 5, day: 17 },
};
const sample2 = { ...emptyContact(0, 3), fullName: 'Иван Петров', given: 'Иван', family: 'Петров', phones: [{ value: '+79991234567', raw: '', type: 'cell' as const, valid: true }], note: 'Звонить после 10:00' };
const sample3 = { ...emptyContact(0, 4), fullName: 'محمد أحمد', given: 'محمد', family: 'أحمد', phones: [{ value: '+966501234567', raw: '', type: 'cell' as const, valid: true }], categories: ['VIP', '友達'] };
---
<Base lang="en" title="Styleguide — csvtovcf" description="Design tokens and components of csvtovcf.com." path="/styleguide/" noindex>
  <div class="wrap sg">
    <header class="page-head">
      <h1>Styleguide</h1>
      <p class="lead">Card-catalog drawer: manila folder, card stock, black ink, a red headline rule, blue ruled lines and one blue accent for actions. Lines and frames, no shadows. Tokens live in <code>src/styles/tokens.css</code>; switch the theme in the header to see the dark drawer.</p>
    </header>

    <section class="section">
      <h2>Colour</h2>
      <ul class="sg-colors">
        {colors.map(([v, n]) => <li><span class="sg-swatch" style={`background:var(${v})`}></span><code>{v}</code><span>{n}</span></li>)}
      </ul>
      <p class="sg-note">Contrast (light): ink on card 16.7:1 · ink-2 on card 8.6:1 · ink-3 on card 6.9:1 · ink-3 on paper 5.5:1 · rule on card 5.8:1 · white on action 7.7:1 · action on card 7.5:1. Dark theme values are checked by the same script (<code>apps/web/scripts/contrast.mjs</code>).</p>
    </section>

    <section class="section">
      <h2>Type</h2>
      <p>IBM Plex Sans 400/600 for interface and headings, IBM Plex Mono 400/500 for data, card text and labels. SIL Open Font License, self-hosted woff2, <code>unicode-range</code> subsets.</p>
      <ul class="sg-type">
        {sizes.map((v) => <li style={`font-size:var(${v})`}><code>{v}</code> Kontakt Контакт Ğğİı 連絡先 جهة اتصال</li>)}
      </ul>
      <p class="mono">Mono: +1 202 555 0143 · ann.lee@example.com · 0123456789</p>
      <p><span class="label">Label</span> <span class="label label--framed">Framed label</span> <span class="label label--framed"><span class="step">1</span>Step</span></p>
    </section>

    <section class="section">
      <h2>Space, lines, radius</h2>
      <ul class="sg-space">
        {space.map((v) => <li><span style={`inline-size:var(${v})`}></span><code>{v}</code></li>)}
      </ul>
      <ul class="sg-lines">
        <li><span style="border-block-start:var(--bw-hair) solid var(--ink)"></span><code>--bw-hair 1px</code></li>
        <li><span style="border-block-start:var(--bw-rule) solid var(--rule)"></span><code>--bw-rule 2px (red rule)</code></li>
        <li><span style="border-block-start:var(--bw-heavy) solid var(--action)"></span><code>--bw-heavy 3px (focus)</code></li>
        <li><span style="border:var(--bw-hair) solid var(--ink);border-radius:var(--r-card);block-size:2rem"></span><code>--r-card 2px — the only radius</code></li>
      </ul>
    </section>

    <section class="section">
      <h2>Buttons and inputs</h2>
      <p class="sg-row">
        <button class="btn" type="button">Download contacts.vcf</button>
        <button class="btn btn--ghost" type="button">Paste cells</button>
        <button class="btn btn--quiet" type="button">Show empty columns</button>
        <button class="btn" type="button" disabled>Disabled</button>
      </p>
      <p class="sg-row">
        <select><option>Windows-1251 (Cyrillic) — detected</option></select>
        <label class="check"><input type="checkbox" checked /> First row is a header</label>
        <label class="radio"><input type="radio" name="r" checked /> 3.0 — imports everywhere</label>
      </p>
    </section>

    <section class="section">
      <h2>Catalog cards</h2>
      <div class="cards">
        <Card c={sample} s={s} intl="en-US" />
        <Card c={sample2} s={s} intl="ru-RU" />
        <Card c={sample3} s={s} intl="ar" />
      </div>
    </section>

    <section class="section">
      <h2>Table, steps, FAQ</h2>
      <div class="table-wrap"><table><thead><tr><th>Feature</th><th>Details</th></tr></thead><tbody><tr><th>Input</th><td>CSV, XLSX, XLS, ODS</td></tr><tr><th>Output</th><td>vCard 3.0, 4.0, 2.1</td></tr></tbody></table></div>
      <ol class="steps"><li><span>Drop the file.</span></li><li><span>Check the plugs.</span></li><li><span>Download.</span></li></ol>
      <div class="faq"><details open><summary>Is my file uploaded?</summary><div class="answer">No.</div></details></div>
    </section>
  </div>
</Base>

<style>
  .sg-colors,
  .sg-type,
  .sg-space,
  .sg-lines {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: var(--s-2);
  }
  .sg-colors li {
    display: grid;
    grid-template-columns: 3rem 10rem 1fr;
    gap: var(--s-3);
    align-items: center;
    font-size: var(--fs-1);
  }
  .sg-swatch {
    block-size: 2rem;
    border: var(--bw-hair) solid var(--ink);
  }
  .sg-note {
    margin-block-start: var(--s-4);
    font-size: var(--fs-1);
    color: var(--ink-2);
  }
  .sg-type li {
    line-height: 1.3;
  }
  .sg-type code {
    font-size: var(--fs-0);
    color: var(--ink-3);
    margin-inline-end: var(--s-3);
  }
  .sg-space li,
  .sg-lines li {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: var(--s-3);
    align-items: center;
  }
  .sg-space span {
    display: block;
    block-size: 1rem;
    background: var(--action);
  }
  .sg-lines span {
    display: block;
    inline-size: 8rem;
  }
  .sg-lines {
    margin-block-start: var(--s-5);
  }
  .sg-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    align-items: center;
    margin-block-end: var(--s-4);
  }
  .sg .section > * + * {
    margin-block-start: var(--s-4);
  }
</style>
