---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import plexLatin from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
import plexLatinExt from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-ext-400-normal.woff2?url';
import plexCyr from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-cyrillic-400-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { LANG_META, type Lang } from '../i18n/config';
import { dict } from '../i18n';
import {
  SITE_URL,
  ANALYTICS_PROVIDER,
  PLAUSIBLE_DOMAIN,
  PLAUSIBLE_SRC,
  GSC_VERIFICATION,
  BING_VERIFICATION,
} from '../config/env';

export interface Alternate {
  lang: Lang;
  path: string;
}
interface Props {
  lang: Lang;
  title: string;
  description: string;
  path: string;
  alternates?: Alternate[];
  noindex?: boolean;
  jsonld?: object[];
  ogImage?: string;
  mdPath?: string;
  pageId?: string;
}
const { lang, title, description, path, alternates = [], noindex = false, jsonld = [], ogImage, mdPath, pageId } = Astro.props;
const meta = LANG_META[lang];
const d = dict(lang);
const canonical = SITE_URL + path;
const xDefault = alternates.find((a) => a.lang === 'en');
const fontPreload = lang === 'ru' ? [plexCyr] : lang === 'tr' ? [plexLatin, plexLatinExt] : [plexLatin];
const og = ogImage ? SITE_URL + ogImage : undefined;
const bannerData = JSON.stringify(
  alternates.filter((a) => a.lang !== lang).map((a) => ({ l: LANG_META[a.lang].hreflang.toLowerCase(), p: a.path, n: LANG_META[a.lang].name })),
);
---
<!doctype html>
<html lang={meta.hreflang} dir={meta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    {!noindex && alternates.map((a) => <link rel="alternate" hreflang={LANG_META[a.lang].hreflang} href={SITE_URL + a.path} />)}
    {!noindex && xDefault && <link rel="alternate" hreflang="x-default" href={SITE_URL + xDefault.path} />}
    {mdPath && <link rel="alternate" type="text/markdown" href={SITE_URL + mdPath} title="Markdown" />}
    {fontPreload.map((f) => <link rel="preload" href={f} as="font" type="font/woff2" crossorigin />)}
    <meta name="theme-color" content="#ede3c8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#191712" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="csvtovcf" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={meta.ogLocale} />
    {og && <meta property="og:image" content={og} />}
    {og && <meta property="og:image:width" content="1200" />}
    {og && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    {GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}
    {BING_VERIFICATION && <meta name="msvalidate.01" content={BING_VERIFICATION} />}
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    {
      ANALYTICS_PROVIDER === 'plausible' && (
        <script defer data-domain={PLAUSIBLE_DOMAIN} src={PLAUSIBLE_SRC} />
      )
    }
  </head>
  <body data-page={pageId}>
    <a class="skip-link" href="#main">{d.site.skipContent}</a>
    <div class="lang-banner" id="lang-banner" hidden data-alts={bannerData} data-text={d.banner.available} data-open={d.banner.open}>
      <div class="wrap">
        <span id="lang-banner-text"></span>
        <a id="lang-banner-link" href="/"></a>
        <button type="button" id="lang-banner-close" aria-label={d.banner.dismiss}>×</button>
      </div>
    </div>
    <Header lang={lang} alternates={alternates} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import { initChrome } from '../lib/chrome';
      initChrome();
    </script>
  </body>
</html>
