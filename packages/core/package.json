{
  "name": "csvtovcf",
  "version": "1.0.0",
  "description": "Convert contact spreadsheets (CSV, XLSX, Google Contacts, Outlook, LinkedIn) to vCard 2.1/3.0/4.0. Encoding detection, column auto-mapping, phone normalization, duplicate detection. Runs in browsers, workers and Node.",
  "keywords": ["vcard", "vcf", "csv", "contacts", "excel", "google-contacts", "outlook", "converter", "csv-to-vcf"],
  "homepage": "https://csvtovcf.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itensity-dev/csvtovcf.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./spreadsheet": {
      "types": "./dist/spreadsheet.d.ts",
      "import": "./dist/spreadsheet.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "node scripts/make-fixtures.mjs"
  },
  "dependencies": {
    "chardet": "2.2.0",
    "libphonenumber-js": "1.13.15",
    "papaparse": "5.7.0"
  },
  "peerDependencies": {
    "xlsx": "*"
  },
  "peerDependenciesMeta": {
    "xlsx": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.16",
    "ical.js": "2.2.1",
    "typescript": "~6.0.3",
    "vitest": "5.1.0",
    "xlsx": "npm:@e965/xlsx@0.20.3"
  }
}
